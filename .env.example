# 환경변수 템플릿 파일 (Git에 커밋됨)
# 사용법: 이 파일을 .env 로 복사한 뒤 실제 값을 채우세요.
#   cp .env.example .env
# 실제 비밀값(.env)은 절대 커밋하지 마세요.

# ===== App =====
APP_ENV=development
APP_PORT=3000
APP_URL=http://localhost:3000

# ===== Database =====
DB_HOST=localhost
DB_PORT=5432
DB_NAME=project002
DB_USER=
DB_PASSWORD=

# ===== Security =====
SECRET_KEY=

# ===== External APIs =====
API_KEY=
# Claude API 키 (https://console.anthropic.com 에서 발급) - 채팅 분석에 사용
ANTHROPIC_API_KEY=
