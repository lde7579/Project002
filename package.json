{
  "name": "chat-analyzer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test",
    "parse": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/parse-stats.ts",
    "smoke": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/smoke-analyze.ts",
    "check-secrets": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-secrets.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "next": "16.4.5",
    "papaparse": "^5.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^26.6.6",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
